generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VENDOR
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String?    @unique
  mobile       String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}