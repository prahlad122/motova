generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VENDOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum VendorVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum VendorDocumentType {
  GST_CERTIFICATE
  BUSINESS_LICENSE
  IDENTITY_PROOF
  ADDRESS_PROOF
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  ORDER_RESERVED
  ORDER_RELEASED
  RETURNED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum NotificationType {
  SYSTEM
  ORDER
  PRODUCT
  VERIFICATION
  PAYMENT
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUNDED
  CLOSED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  SIZE_OR_FIT
  CHANGED_MIND
  OTHER
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String?    @unique
  mobile       String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  vendorProfile              VendorProfile?
  customerProfile            CustomerProfile?
  reviewedDocuments          DocumentReview[]     @relation("DocumentReviewer")
  listingReviews             ListingReview[]      @relation("ListingReviewer")
  notifications              Notification[]
  auditLogs                  AuditLog[]           @relation("AuditActor")
  inventoryMovementsRecorded InventoryMovement[]  @relation("InventoryRecorder")

  @@index([role, status])
}

model VendorProfile {
  id                  String                   @id @default(uuid())
  userId              String                   @unique
  businessName        String?
  businessDescription String?                  @db.Text
  businessEmail       String?
  businessPhone       String?
  businessAddress     String?                  @db.Text
  city                String?
  state               String?
  postalCode          String?
  country             String                   @default("India")
  verificationStatus  VendorVerificationStatus @default(NOT_SUBMITTED)
  verificationNote    String?                  @db.Text
  verifiedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents          VendorDocument[]
  products           Product[]
  inventoryMovements InventoryMovement[]
  vendorOrders       VendorOrder[]
  payouts            VendorPayout[]

  @@index([verificationStatus])
  @@index([businessName])
}

model VendorDocument {
  id              String             @id @default(uuid())
  vendorProfileId String
  type            VendorDocumentType
  fileName        String
  fileUrl         String
  storageKey      String?
  status          ReviewStatus       @default(PENDING)
  submittedAt     DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  vendor  VendorProfile   @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  reviews DocumentReview[]

  @@index([vendorProfileId, status])
}

model DocumentReview {
  id         String       @id @default(uuid())
  documentId String
  reviewerId String
  status     ReviewStatus
  note       String?      @db.Text
  reviewedAt DateTime     @default(now())

  document VendorDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  reviewer User           @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([documentId, reviewedAt])
  @@index([reviewerId])
}

model CustomerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  dateOfBirth DateTime?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses CustomerAddress[]
  cart      Cart?
  wishlist  Wishlist?
  orders    Order[]
  reviews   ProductReview[]
  returns   ReturnRequest[]

  @@index([createdAt])
}

model CustomerAddress {
  id                String   @id @default(uuid())
  customerProfileId String
  label             String?
  recipientName     String
  phone             String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  postalCode        String
  country           String   @default("India")
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)

  @@index([customerProfileId, isDefault])
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  parentId    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive])
}

model Brand {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model Product {
  id              String        @id @default(uuid())
  vendorProfileId String
  categoryId      String
  brandId         String?
  name            String
  slug            String        @unique
  description     String?       @db.Text
  sku             String
  price           Decimal       @db.Decimal(12, 2)
  compareAtPrice  Decimal?      @db.Decimal(12, 2)
  stockQuantity   Int           @default(0)
  status          ProductStatus @default(DRAFT)
  listingStatus   ReviewStatus  @default(PENDING)
  listingNote     String?       @db.Text
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vendor            VendorProfile      @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand             Brand?             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images            ProductImage[]
  inventoryMovements InventoryMovement[]
  listingReviews    ListingReview[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  reviews           ProductReview[]

  @@unique([vendorProfileId, sku])
  @@index([vendorProfileId, status])
  @@index([categoryId, status])
  @@index([brandId])
  @@index([listingStatus, status])
  @@index([createdAt])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  imageUrl   String
  storageKey String?
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
}

model InventoryMovement {
  id              String               @id @default(uuid())
  vendorProfileId String
  productId       String
  type            InventoryMovementType
  quantity        Int
  note            String?
  reference       String?
  recordedById    String?
  createdAt       DateTime             @default(now())

  vendor     VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  recordedBy User?         @relation("InventoryRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([vendorProfileId, createdAt])
  @@index([productId, createdAt])
  @@index([recordedById])
}

model ListingReview {
  id              String       @id @default(uuid())
  productId       String
  reviewerId      String
  status          ReviewStatus
  note            String?      @db.Text
  reviewedAt      DateTime     @default(now())

  product  Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  reviewer User    @relation("ListingReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([productId, reviewedAt])
  @@index([reviewerId])
}

model Cart {
  id                String   @id @default(uuid())
  customerProfileId String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  items    CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
}

model Wishlist {
  id                String   @id @default(uuid())
  customerProfileId String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  items    WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([wishlistId, productId])
  @@index([productId])
}

model Order {
  id                 String        @id @default(uuid())
  orderNumber        String        @unique
  customerProfileId  String
  customerName       String
  customerEmail      String?
  customerPhone      String?
  shippingAddress    String        @db.Text
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String        @default("India")
  subtotal           Decimal       @db.Decimal(12, 2)
  shippingFee        Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  status             OrderStatus   @default(PENDING)
  paymentStatus      PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer    CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  vendorOrders VendorOrder[]
  payments    Payment[]

  @@index([customerProfileId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([customerEmail])
}

model VendorOrder {
  id              String      @id @default(uuid())
  orderId         String
  vendorProfileId String
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal    @default(0) @db.Decimal(12, 2)
  vendorAmount    Decimal     @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  order    Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendor   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  shipment Shipment?
  payoutItems PayoutItem[]

  @@unique([orderId, vendorProfileId])
  @@index([vendorProfileId, status, createdAt])
  @@index([orderId])
}

model OrderItem {
  id            String   @id @default(uuid())
  vendorOrderId String
  productId     String
  productName   String
  sku           String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  lineTotal     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  returns     ReturnRequest[]

  @@index([vendorOrderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  provider          String?
  providerReference String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
}

model Shipment {
  id             String         @id @default(uuid())
  vendorOrderId  String         @unique
  carrier        String?
  trackingNumber String?        @unique
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
}

model VendorPayout {
  id              String   @id @default(uuid())
  vendorProfileId String
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("INR")
  status          String   @default("PENDING")
  reference       String?  @unique
  note            String?  @db.Text
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  items  PayoutItem[]

  @@index([vendorProfileId, status])
}

model PayoutItem {
  id             String      @id @default(uuid())
  payoutId       String
  vendorOrderId  String
  amount         Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())

  payout      VendorPayout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  vendorOrder VendorOrder  @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)

  @@unique([payoutId, vendorOrderId])
  @@index([vendorOrderId])
}

model ProductReview {
  id                String   @id @default(uuid())
  customerProfileId String
  productId         String
  rating            Int
  title             String?
  comment           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([customerProfileId, productId])
  @@index([productId, createdAt])
}

model ReturnRequest {
  id                String       @id @default(uuid())
  customerProfileId String
  orderItemId       String
  quantity          Int
  reason            ReturnReason
  details           String?      @db.Text
  status            ReturnStatus @default(REQUESTED)
  requestedAt       DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  resolvedAt        DateTime?

  customer CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([customerProfileId, status, requestedAt])
  @@index([orderItemId, status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String           @db.Text
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
